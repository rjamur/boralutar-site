    <!-- Janela do Chat (Simulada) -->
    <div id="chat-window" class="fixed bottom-24 right-6 w-[90%] md:w-96 bg-white rounded-2xl shadow-2xl z-50 transform translate-y-[120%] opacity-0 transition-all duration-300 border border-slate-200 overflow-hidden flex flex-col h-[500px]">
        
        <!-- Chat Header -->
