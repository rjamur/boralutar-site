        </div>

        <!-- Chat Body -->
        <div class="flex-1 bg-slate-50 p-4 overflow-y-auto space-y-4" id="chat-messages">
            <!-- Mensagem do Bot -->
            <div class="flex gap-3">
                <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0 text-xs font-bold">Bot</div>
                <div class="bg-white p-3 rounded-r-xl rounded-bl-xl shadow-sm text-sm text-slate-700 border border-slate-100">
                    Olá! Bem-vindo ao NOIAS. Sou um assistente virtual. <br><br>
                    Você precisa de ajuda para si mesmo ou para outra pessoa?
                </div>
            </div>

            <!-- Sugestões -->
            <div class="flex flex-wrap gap-2 pl-11">
                <button class="px-3 py-1.5 bg-blue-100 hover:bg-blue-200 text-blue-700 text-xs rounded-full font-medium transition">Para mim</button>
                <button class="px-3 py-1.5 bg-blue-100 hover:bg-blue-200 text-blue-700 text-xs rounded-full font-medium transition">Para um familiar</button>
                <button class="px-3 py-1.5 bg-blue-100 hover:bg-blue-200 text-blue-700 text-xs rounded-full font-medium transition">Quero ser voluntário</button>
            </div>
        </div>

        <!-- Chat Input -->
        <div class="p-3 bg-white border-t border-slate-100">
            <form onsubmit="event.preventDefault(); sendMessage();" class="relative">
                <input type="text" id="user-input" placeholder="Digite sua mensagem..." class="w-full bg-slate-100 text-slate-800 rounded-full pl-4 pr-12 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
