            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        // Lógica simples para abrir/fechar o Chat Mockup
        function toggleChat() {
            const chatWindow = document.getElementById('chat-window');
            const isClosed = chatWindow.classList.contains('translate-y-[120%]');
            
            if (isClosed) {
                chatWindow.classList.remove('translate-y-[120%]', 'opacity-0');
                chatWindow.classList.add('translate-y-0', 'opacity-100');
            } else {
                chatWindow.classList.add('translate-y-[120%]', 'opacity-0');
                chatWindow.classList.remove('translate-y-0', 'opacity-100');
            }
        }

        // Simulação de envio de mensagem
        function sendMessage() {
            const input = document.getElementById('user-input');
            const message = input.value;
            if (!message.trim()) return;

            const chatMessages = document.getElementById('chat-messages');

            // Adiciona mensagem do usuário
            const userMsgHTML = `
                <div class="flex gap-3 justify-end">
                    <div class="bg-blue-600 p-3 rounded-l-xl rounded-br-xl shadow-sm text-sm text-white">
                        ${message}
                    </div>
                </div>
            `;
            chatMessages.insertAdjacentHTML('beforeend', userMsgHTML);
            input.value = '';
            chatMessages.scrollTop = chatMessages.scrollHeight;

            // Simula "Digitando..." e resposta
            setTimeout(() => {
                const typingHTML = `
                    <div class="flex gap-3 typing-indicator" id="typing">
                        <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0 text-xs font-bold">Bot</div>
                        <div class="bg-white p-3 rounded-r-xl rounded-bl-xl shadow-sm border border-slate-100 flex items-center gap-1">
                            <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce"></span>
                            <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></span>
                            <span class="w-2 h-2 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></span>
                        </div>
                    </div>
                `;
                chatMessages.insertAdjacentHTML('beforeend', typingHTML);
                chatMessages.scrollTop = chatMessages.scrollHeight;

                setTimeout(() => {
                    document.getElementById('typing').remove();
                    const botMsgHTML = `
                        <div class="flex gap-3">
                            <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0 text-xs font-bold">Bot</div>
                            <div class="bg-white p-3 rounded-r-xl rounded-bl-xl shadow-sm text-sm text-slate-700 border border-slate-100">
                                Obrigado pelo contato. Um assistente social voluntário ou nosso sistema automático irá responder em breve pelo Chatwoot.
                            </div>
                        </div>
                    `;
                    chatMessages.insertAdjacentHTML('beforeend', botMsgHTML);
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }, 1500);

            }, 500);
        }

        /* INSTRUÇÕES PARA O CHATWOOT REAL:
        1. Remova todo o bloco HTML "Janela do Chat (Simulada)" e o botão flutuante acima.
        2. Remova as funções toggleChat e sendMessage deste script.
        3. Cole aqui o script que o Chatwoot fornece (Settings > Inboxes > Add Website).
        
        Exemplo do script Chatwoot:
        (function(d,t) {
          var BASE_URL="https://seu-chatwoot-url.com";
          var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
          g.src=BASE_URL+"/packs/js/sdk.js";
          g.defer = true;
          g.async = true;
          s.parentNode.insertBefore(g,s);
          g.onload=function(){
            window.chatwootSDK.run({
              websiteToken: 'SEU_TOKEN_AQUI',
              baseUrl: BASE_URL
            })
          }
        })(document,"script");
        */
    </script>
