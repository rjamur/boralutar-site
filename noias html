    <!-- 
    =======================================================================
    SIMULAÇÃO DO CHATWOOT (MOCKUP)
    Para produção, você deve remover este HTML/CSS e colar o script JS 
    fornecido pelo painel do seu Chatwoot.
    ======================================================================= 
    -->
    
    <!-- Botão Flutuante do Chat (Abre o Widget) -->
    <button onclick="toggleChat()" class="fixed bottom-6 right-6 w-14 h-14 bg-blue-600 text-white rounded-full shadow-2xl flex items-center justify-center text-2xl hover:bg-blue-700 transition z-50 focus:outline-none focus:ring-4 focus:ring-blue-300">
